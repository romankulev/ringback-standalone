# Ringback standalone server configuration.
# Copy this file to .env, fill the required values, and keep .env private.
# Never commit secrets or paste them into chat.

# ---------------------------------------------------------------------------
# REQUIRED: Telegram Mini App delivery and access control.
# Create the bot with @BotFather, then run this twice. On the first run it
# creates a one-time /start code; send that exact command to the bot. The
# second run writes the matched numeric IDs and rotates the code:
#   .venv/bin/python configure_telegram.py discover --write
# The helper writes the numeric IDs below without displaying your bot token.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_ALLOWED_USER_IDS=""
VOICE_TELEGRAM_USER_ID=""
TELEGRAM_PAIRING_CODE=""

# REQUIRED on a phone: the stable public HTTPS URL of this Mini App.
# A reverse proxy such as Caddy/Nginx or a secure tunnel normally forwards it
# to WEBRTC_HOST:WEBRTC_PORT. Register the same URL for the bot in BotFather.
WEBRTC_PUBLIC_URL=""
WEBRTC_HOST="127.0.0.1"
WEBRTC_PORT="8765"

# Browser and server ICE configuration. Public STUN is enough for local tests;
# reliable production calls across mobile networks normally require TURN.
# Keep TURN usernames and passwords only in .env.
WEBRTC_ICE_SERVERS_JSON='[{"urls":["stun:stun.l.google.com:19302"]}]'
# Example:
# WEBRTC_ICE_SERVERS_JSON='[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.example.com:3478?transport=udp","turns:turn.example.com:5349?transport=tcp"],"username":"USER","credential":"PASSWORD"}]'

# Optional direct TLS termination. Leave blank when the reverse proxy/tunnel
# serves HTTPS and forwards plain HTTP/WebSocket traffic to this process.
WEBRTC_TLS_CERT=""
WEBRTC_TLS_KEY=""
WEBRTC_WS_MAX_BYTES="262144"
WEBRTC_MAX_PENDING_AUTH="32"
WEBRTC_MAX_PENDING_AUTH_PER_IP="4"
WEBRTC_MAX_CLIENTS_PER_USER="4"

# ---------------------------------------------------------------------------
# REQUIRED: standalone conversation brain.
# OPENAI_MODEL must be an exact OpenAI model ID available to your API project.
# gpt-5.6-luna is the lightweight, cost-sensitive default.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-luna"
OPENAI_BASE_URL="https://api.openai.com/v1/chat/completions"
OPENAI_TEMPERATURE=""
OPENAI_REASONING_EFFORT="low"
OPENAI_MAX_TOOL_ROUNDS="6"
OPENAI_MAX_TOOL_CALLS_PER_TURN="8"
OPENAI_MAX_TOKENS="600"
OPENAI_TURN_TIMEOUT="60"

# ---------------------------------------------------------------------------
# OPTIONAL but expected for YCLIENTS: remote n8n MCP tools.
# Put the active production MCP Trigger URL here. The legacy Netherlands URL
# responds, but has no separate header authorization, so it is intentionally
# not hardcoded. Protect the endpoint first; the app then discovers its tools
# dynamically with tools/list.
# ---------------------------------------------------------------------------
MCP_SERVERS_JSON='[]'
# Production example with a bearer token kept outside the JSON literal:
# MCP_SERVERS_JSON='[{"server_label":"nami_booking","server_url":"https://YOUR-N8N-HOST/mcp/YOUR-ACTIVE-MCP-ID","authorization":"Bearer ${N8N_MCP_TOKEN}"}]'
N8N_MCP_TOKEN=""
MCP_PROTOCOL_VERSION="2025-03-26"
MCP_REQUEST_TIMEOUT="15"

# read_only exposes get/list/check/read/find/search/current/available-style
# tools. To permit any write action, explicitly review and list its exact name.
MCP_TOOL_POLICY="read_only"
MCP_ALLOWED_TOOLS=""

# Private instruction for the standalone voice agent. The per-call objective
# can also be supplied by the application when a call starts.
AUTONOMOUS_SYSTEM_PROMPT=""
STANDALONE_OBJECTIVE="Помогай пользователю с услугами и свободными окнами YCLIENTS."
STANDALONE_GREETING="Здравствуйте! Я голосовой ассистент. Чем могу помочь?"
STANDALONE_ANSWER_TIMEOUT="45"
STANDALONE_SILENCE_RETRIES="2"
TELEGRAM_POLL_TIMEOUT="20"
TELEGRAM_DROP_PENDING_UPDATES="1"
AUTONOMOUS_MAX_TURNS="12"

# ---------------------------------------------------------------------------
# REQUIRED in the default lightweight profile: ElevenLabs cloud speech.
# Scribe v2 transcribes Russian; the selected voice reads assistant replies.
# No local AI model is loaded. To use the optional offline fallback instead,
# run setup with INSTALL_LOCAL_VOICE=1 and select VOICE_STT="local" plus
# VOICE_TTS="piper".
# Audio turns are sent to ElevenLabs; transcripts and MCP results are sent to
# OpenAI. Provider-side retention is governed by their account/settings.
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=""
ELEVENLABS_STT_MODEL_ID="scribe_v2"
ELEVENLABS_VOICE_ID=""
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"
VOICE_STT="elevenlabs"
VOICE_TTS="elevenlabs"

# Local speech-to-text / fallback text-to-speech installed by setup scripts.
# These Whisper models are multilingual and suitable for Russian speech.
WHISPER_SERVER_MODEL="$HOME/.whisper-models/ggml-base.bin"
WHISPER_MODEL="$HOME/.whisper-models/ggml-small.bin"
WHISPER_LANGUAGE="ru"
VOICE_PIPER_MODEL="$HOME/.piper-voices/ru_RU-irina-medium.onnx"

# Optional timing, diagnostics and call behavior.
TELEGRAM_INIT_DATA_MAX_AGE="86400"
VOICE_START_TIMEOUT="4.0"
VOICE_END_SILENCE="1.5"
VOICE_HALF_DUPLEX="0"
VOICE_DEBUG="0"

# Local browser development only. Never enable this on a public server.
TELEGRAM_DEV_MODE="0"
TELEGRAM_DEV_USER_ID="1"
